# Site URL used for canonical/OG metadata in lib/seo.ts
NEXT_PUBLIC_SITE_URL=https://mihsab.example

# Optional — enables live currency rates in lib/services/currencyService.ts.
# Without this, the app falls back to static indicative rates.
EXCHANGE_RATE_API_KEY=

# Optional — enables live gold price lookup in lib/services/goldService.ts.
# Without this, users must enter the gold price per gram manually.
GOLD_PRICE_API_KEY=
